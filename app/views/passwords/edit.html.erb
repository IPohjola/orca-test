<h1 class="page-title"><%= t(".title") %></h1>

<%= render "layouts/page_section" do %>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="inline-field-group inline-field-group--equal inline-field-group--stack">
      <div class="inline-field">
        <%= form.label :password, t("passwords.edit.password"), class: "required-field" %>
        <%= form.password_field :password, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="inline-field">
        <%= form.label :password_confirmation, t("passwords.edit.password_confirmation"), class: "required-field" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72 %>
      </div>
    </div>
    <div class="action-group action-group--stack">
      <%= form.submit t("passwords.edit.submit"), data: { disable_with: t("passwords.edit.submit") } %>
    </div>
  <% end %>
<% end %>
