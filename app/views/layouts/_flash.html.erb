<% if flash.any? %>
  <div class="flash-stack">
    <% flash.each do |level, message| %>
      <div class="flash flash--<%= level %>" data-controller="flash" role="status">
        <span class="flash-message"><%= message %></span>
        <button class="flash-close" data-action="flash#dismiss" type="button" aria-label="<%= t("flash.close") %>">×</button>
      </div>
    <% end %>
  </div>
<% end %>
